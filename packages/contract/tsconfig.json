{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "rootDir": "src",
    "paths": {
      "@repo/contract": ["./src"],
      "@repo/contract/*": ["./src/*"],
      "@repo/db": ["../db/src"],
      "@repo/db/*": ["../db/src/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules"]
}
