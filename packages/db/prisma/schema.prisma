datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

enum PetSpecies {
  DOG
  CAT
}

enum PetGender {
  MALE
  FEMALE
  UNKNOWN
}

enum StaffRole {
  GROOMER
  MANAGER
  ADMIN
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AppointmentSource {
  WALK_IN
  ONLINE
  LINE
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  MEMBER_BALANCE
}

model Customer {
  id               String   @id @default(cuid())
  phone            String   @unique
  name             String
  email            String?
  emergencyContact String?
  emergencyPhone   String?
  lineUserId       String?  @unique
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  pets         Pet[]
  appointments Appointment[]
  orders       Order[]
}

model Pet {
  id                String     @id @default(cuid())
  customerId        String
  name              String
  species           PetSpecies
  breed             String?
  birthDate         DateTime?
  weightKg          Decimal?   @db.Decimal(5, 2)
  gender            PetGender
  isAggressive      Boolean    @default(false)
  hasDisease        Boolean    @default(false)
  diseaseNotes      String?
  isVaccinated      Boolean    @default(false)
  isDewormed        Boolean    @default(false)
  preferredVetName  String?
  preferredVetPhone String?
  avatarUrl         String?
  notes             String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  customer     Customer      @relation(fields: [customerId], references: [id])
  appointments Appointment[]
  orders       Order[]

  @@index([customerId])
}

model Staff {
  id        String    @id @default(cuid())
  name      String
  role      StaffRole
  phone     String?
  isActive  Boolean   @default(true)
  surcharge    Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  appointments Appointment[]
  orders       Order[]
}

// ─── Appointment ──────────────────────────────────────────────────────────────

model Appointment {
  id                String            @id @default(cuid())
  customerId        String
  petId             String
  staffId           String?
  scheduledAt       DateTime
  estimatedDuration Int               // 預估分鐘數
  actualStartAt     DateTime?
  actualEndAt       DateTime?
  pickupDeadlineAt  DateTime?         // 約定接回時間
  pickedUpAt        DateTime?         // 實際接回時間
  status            AppointmentStatus @default(PENDING)
  source            AppointmentSource @default(WALK_IN)
  notes             String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  customer Customer @relation(fields: [customerId], references: [id])
  pet      Pet      @relation(fields: [petId], references: [id])
  staff    Staff?   @relation(fields: [staffId], references: [id])
  order    Order?

  @@index([scheduledAt])
  @@index([customerId])
  @@index([staffId, scheduledAt])
}

// ─── Order ────────────────────────────────────────────────────────────────────

model Order {
  id              String        @id @default(cuid())
  /// 可能是現場直接開單（無預約）
  appointmentId   String?       @unique
  customerId      String
  petId           String
  staffId         String?
  status          OrderStatus   @default(DRAFT)
  subtotalAmount  Int           // 小計（元）
  discountAmount  Int           @default(0)
  /// §: 逾30分鐘才可計收
  overtimeFee     Int           @default(0)
  totalAmount     Int           // 總計（元）
  paidAt          DateTime?
  paymentMethod   PaymentMethod?
  notes           String?
  /// FK → Contract（待建）
  contractId      String?       @unique
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  appointment Appointment? @relation(fields: [appointmentId], references: [id])
  customer    Customer     @relation(fields: [customerId], references: [id])
  pet         Pet          @relation(fields: [petId], references: [id])
  staff       Staff?       @relation(fields: [staffId], references: [id])
  items       OrderItem[]

  @@index([customerId, createdAt])
  @@index([status])
}

// ─── OrderItem ────────────────────────────────────────────────────────────────

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  /// FK → Service（待建）；保留字串以便未來加 @relation
  serviceId   String
  /// 下單時的名稱快照，避免服務改名影響歷史紀錄
  serviceName String
  quantity    Int      @default(1)
  unitPrice   Int      // 元
  amount      Int      // 小計（元）
  notes       String?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}
