datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

// ─── Store（多店支援）────────────────────────────────────────────────────────

model Store {
  id                    String   @id @default(cuid())
  name                  String
  slug                  String   @unique
  address               String?
  phone                 String?
  taxId                 String?
  lineOaId              String?
  businessHours         Json?
  overtimeFeePerHour    Int      @default(0)
  overtimeGraceMinutes  Int      @default(30)
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  customers    Customer[]
  pets         Pet[]
  staff        Staff[]
  services     Service[]
  appointments Appointment[]
  orders       Order[]
  contracts    Contract[]
  memberPlans  MemberPlan[]
  promotions   Promotion[]
}

enum PetSpecies {
  DOG
  CAT
}

enum PetGender {
  MALE
  FEMALE
  UNKNOWN
}

enum StaffRole {
  GROOMER
  MANAGER
  ADMIN
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AppointmentSource {
  WALK_IN
  ONLINE
  LINE
  POS_ONSITE
}

enum SignMethod {
  ONSITE
  ONLINE
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  MEMBER_BALANCE
}

enum ServiceCategory {
  BATH
  HAIRCUT
  NAIL
  SPA
  OTHER
}

enum AdjustmentType {
  FIXED
  PERCENTAGE
}

enum PointTransactionType {
  EARN
  REDEEM
  ADJUST
  EXPIRE
}

enum BalanceTransactionType {
  TOPUP
  SPEND
  REFUND
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum ContractType {
  SINGLE_SERVICE
  PACKAGE
  SUPPLEMENTARY
}

model Customer {
  id               String    @id @default(cuid())
  storeId          String
  phone            String
  name             String
  email            String?
  emergencyContact String?
  emergencyPhone   String?
  lineUserId       String?   @unique
  lineBindAt       DateTime?
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  store        Store         @relation(fields: [storeId], references: [id])
  pets         Pet[]
  appointments Appointment[]
  orders       Order[]
  member       Member?
  contracts    Contract[]

  @@unique([storeId, phone])
  @@index([storeId])
}

model Pet {
  id                String     @id @default(cuid())
  storeId           String
  customerId        String
  name              String
  species           PetSpecies
  breed             String?
  birthDate         DateTime?
  weightKg          Decimal?   @db.Decimal(5, 2)
  gender            PetGender
  isAggressive      Boolean    @default(false)
  hasDisease        Boolean    @default(false)
  diseaseNotes      String?
  isVaccinated      Boolean    @default(false)
  isDewormed        Boolean    @default(false)
  preferredVetName  String?
  preferredVetPhone String?
  avatarUrl         String?
  notes             String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  store        Store         @relation(fields: [storeId], references: [id])
  customer     Customer      @relation(fields: [customerId], references: [id])
  appointments Appointment[]
  orders       Order[]
  contracts    Contract[]

  @@index([storeId])
  @@index([customerId])
}

model Staff {
  id        String    @id @default(cuid())
  storeId   String
  name      String
  role      StaffRole
  phone     String?
  isActive  Boolean   @default(true)
  surcharge Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  store        Store         @relation(fields: [storeId], references: [id])
  appointments Appointment[]
  orders       Order[]

  @@index([storeId])
}

// ─── Service / Pricing ───────────────────────────────────────────────────────

model Service {
  id               String          @id @default(cuid())
  storeId          String
  name             String
  category         ServiceCategory
  description      String?
  basePrice        Int
  isActive         Boolean         @default(true)
  sortOrder        Int             @default(0)
  estimatedMinutes Int             @default(60)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  store        Store                @relation(fields: [storeId], references: [id])
  priceRules   PriceRule[]
  packageItems ServicePackageItem[]
  orderItems   OrderItem[]

  @@index([storeId])
}

model PriceRule {
  id              String         @id @default(cuid())
  serviceId       String
  name            String
  weightMin       Decimal?       @db.Decimal(5, 2)
  weightMax       Decimal?       @db.Decimal(5, 2)
  breed           String?
  priceAdjustment Int
  adjustmentType  AdjustmentType
  isActive        Boolean        @default(true)

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
}

model ServicePackage {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Int
  isActive    Boolean  @default(true)
  validDays   Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items ServicePackageItem[]
}

model ServicePackageItem {
  id        String @id @default(cuid())
  packageId String
  serviceId String
  quantity  Int    @default(1)

  package ServicePackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  service Service        @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([packageId])
  @@index([serviceId])
}

// ─── Member / Promotion ──────────────────────────────────────────────────────

model MemberPlan {
  id           String   @id @default(cuid())
  storeId      String
  name         String
  description  String?
  monthlyFee   Int      @default(0)
  pointRate    Decimal  @default(1.0) @db.Decimal(4, 2)
  discountRate Decimal  @default(0) @db.Decimal(4, 2)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  store   Store    @relation(fields: [storeId], references: [id])
  members Member[]

  @@index([storeId])
}

model Member {
  id         String    @id @default(cuid())
  customerId String    @unique
  planId     String
  points     Int       @default(0)
  balance    Int       @default(0)
  joinedAt   DateTime  @default(now())
  expiresAt  DateTime?

  customer            Customer             @relation(fields: [customerId], references: [id])
  plan                MemberPlan           @relation(fields: [planId], references: [id])
  pointTransactions   PointTransaction[]
  balanceTransactions BalanceTransaction[]

  @@index([planId])
}

model PointTransaction {
  id        String               @id @default(cuid())
  memberId  String
  orderId   String?
  amount    Int
  type      PointTransactionType
  note      String?
  createdAt DateTime             @default(now())

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  order  Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([memberId])
  @@index([orderId])
}

model BalanceTransaction {
  id        String                 @id @default(cuid())
  memberId  String
  orderId   String?
  amount    Int
  type      BalanceTransactionType
  note      String?
  createdAt DateTime               @default(now())

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  order  Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([memberId])
  @@index([orderId])
}

model Promotion {
  id                String       @id @default(cuid())
  storeId           String
  name              String
  code              String?      @unique
  discountType      DiscountType
  discountValue     Int
  minOrderAmount    Int          @default(0)
  maxDiscountAmount Int?
  startAt           DateTime
  endAt             DateTime
  isActive          Boolean      @default(true)
  usageLimit        Int?
  usageCount        Int          @default(0)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  store Store @relation(fields: [storeId], references: [id])

  @@index([storeId])
}

// ─── Contract ────────────────────────────────────────────────────────────────

model ContractTemplate {
  id           String       @id @default(cuid())
  name         String
  type         ContractType
  htmlContent  String
  customFields Json?
  isActive     Boolean      @default(true)
  version      Int          @default(1)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  contracts Contract[]
}

model Contract {
  id                String     @id @default(cuid())
  storeId           String
  /// 主契約必填；補充契約可為 null（加購服務直接附掛在原訂單）
  orderId           String?    @unique
  templateId        String
  customerId        String
  petId             String
  filledData        Json
  customFieldValues Json?
  signatureDataUrl  String
  signedAt          DateTime
  signMethod        SignMethod @default(ONSITE)
  isSupplementary   Boolean   @default(false)
  /// 補充契約指向原契約（self-relation）
  parentContractId  String?
  pdfUrl            String?
  pdfGeneratedAt    DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  store          Store            @relation(fields: [storeId], references: [id])
  order          Order?           @relation(fields: [orderId], references: [id])
  template       ContractTemplate @relation(fields: [templateId], references: [id])
  customer       Customer         @relation(fields: [customerId], references: [id])
  pet            Pet              @relation(fields: [petId], references: [id])
  parentContract Contract?        @relation("Supplement", fields: [parentContractId], references: [id], onDelete: SetNull)
  supplements    Contract[]       @relation("Supplement")

  @@index([storeId])
  @@index([templateId])
  @@index([customerId])
  @@index([petId])
  @@index([parentContractId])
}

// ─── Appointment ──────────────────────────────────────────────────────────────

model Appointment {
  id                String            @id @default(cuid())
  storeId           String
  customerId        String
  petId             String
  staffId           String?
  scheduledAt       DateTime
  estimatedDuration Int // 預估分鐘數
  actualStartAt     DateTime?
  actualEndAt       DateTime?
  pickupDeadlineAt   DateTime? // 約定接回時間
  pickedUpAt         DateTime? // 實際接回時間
  pickupNotifiedAt   DateTime? // 最後一次接送通知時間
  status             AppointmentStatus @default(PENDING)
  source            AppointmentSource @default(WALK_IN)
  signedOnline      Boolean           @default(false)
  onlineContractId  String?
  notes             String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  store    Store             @relation(fields: [storeId], references: [id])
  customer Customer          @relation(fields: [customerId], references: [id])
  pet      Pet               @relation(fields: [petId], references: [id])
  staff    Staff?            @relation(fields: [staffId], references: [id])
  order    Order?

  @@index([storeId, scheduledAt])
  @@index([scheduledAt])
  @@index([customerId])
  @@index([staffId, scheduledAt])
}

// ─── Order ────────────────────────────────────────────────────────────────────

model Order {
  id             String         @id @default(cuid())
  storeId        String
  /// 可能是現場直接開單（無預約）
  appointmentId  String?        @unique
  customerId     String
  petId          String
  staffId        String?
  status         OrderStatus    @default(DRAFT)
  subtotalAmount Int // 小計（元）
  discountAmount Int            @default(0)
  /// §: 逾30分鐘才可計收
  overtimeFee    Int            @default(0)
  totalAmount    Int // 總計（元）
  paidAt         DateTime?
  paymentMethod  PaymentMethod?
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  store               Store                @relation(fields: [storeId], references: [id])
  appointment         Appointment?         @relation(fields: [appointmentId], references: [id])
  customer            Customer             @relation(fields: [customerId], references: [id])
  pet                 Pet                  @relation(fields: [petId], references: [id])
  staff               Staff?               @relation(fields: [staffId], references: [id])
  items               OrderItem[]
  pointTransactions   PointTransaction[]
  balanceTransactions BalanceTransaction[]
  contract            Contract?
  auditLogs           OrderAuditLog[]

  @@index([storeId, createdAt])
  @@index([customerId, createdAt])
  @@index([status])
}

// ─── Order Audit Log ─────────────────────────────────────────────────────────

model OrderAuditLog {
  id        String   @id @default(cuid())
  orderId   String
  action    String   // CREATED | STATUS_CHANGED | CANCELLED | REFUNDED | PAYMENT_UPDATED | NOTE_UPDATED
  oldValue  String?
  newValue  String?
  note      String?
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([createdAt])
}

// ─── LINE Bot Session ─────────────────────────────────────────────────────────

model LineSession {
  lineUserId String   @id @map("line_user_id")
  state      Json
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("line_sessions")
}

// ─── Setting (key-value store) ────────────────────────────────────────────────

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("settings")
}

// ─── OrderItem ────────────────────────────────────────────────────────────────

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  serviceId   String
  /// 下單時的名稱快照，避免服務改名影響歷史紀錄
  serviceName String
  quantity    Int     @default(1)
  unitPrice   Int // 元
  amount      Int // 小計（元）
  notes       String?

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id])

  @@index([orderId])
  @@index([serviceId])
}

