# Supabase / Prisma
DATABASE_URL=
DIRECT_URL=

# Supabase Auth & Storage
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# LINE Bot
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
LINE_LIFF_ID=

# PDF (Puppeteer / @sparticuz/chromium)
# Windows 本地開發（Chrome 已安裝）：
#   PUPPETEER_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# macOS 本地開發：
#   PUPPETEER_EXECUTABLE_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# Vercel / Linux 正式環境：留空（@sparticuz/chromium 自動提供）
PUPPETEER_EXECUTABLE_PATH=

# Cron jobs — 必須設定，否則生產環境 cron API 會回傳 401
# 產生方式：openssl rand -hex 32
CRON_SECRET=

# 多店 — 此台 iPad/POS 所屬店的 Store.id（從 Prisma Studio 或 seed 取得）
STORE_ID=default-store
